{
  "name": "gitlab-mr-actions",
  "private": true,
  "scripts": {
    "dev": "node scripts/build.mjs --dev --watch",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src scripts \"*.config.{mjs,cjs}\" --max-warnings=0",
    "format": "prettier --write \"src/**/*.ts\" \"scripts/**/*.mjs\" \"*.config.{mjs,cjs}\" \"*.json\" \".prettierrc.json\" \".github/**/*.yml\"",
    "test": "node --test tests/*.test.cjs",
    "package": "npm run build && node scripts/package.mjs",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run lint:architecture && npm run release:check && npm test",
    "docs:build": "python3 docs/build_pages.py",
    "release:check": "node scripts/release.mjs check",
    "release:notes": "node scripts/release.mjs notes",
    "pretest": "npm run build",
    "test:browser": "npm run build && playwright test",
    "test:performance": "npm run build && node scripts/profile-runtime.mjs --check",
    "lint:architecture": "node scripts/check-architecture.mjs",
    "format:check": "prettier --check \"src/**/*.ts\" \"scripts/**/*.mjs\" \"*.config.{mjs,cjs}\" \"*.json\" \".prettierrc.json\" \".github/**/*.yml\""
  },
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || ^26.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "overrides": {
    "minimatch": "11.0.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@types/chrome": "0.3.7",
    "@types/node": "26.6.6",
    "esbuild": "0.28.2",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  }
}
